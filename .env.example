GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# --- Fallback LLM providers (api_resilience.py 7-provider chain) ---
# Chain order: Cerebras → NVIDIA NIM → Groq → Gemini → OpenRouter → Together → Ollama

# 1. Cerebras: 1M tokens/DAY completely free — BEST free option, start here
#    Sign up: cloud.cerebras.ai → API Keys (no credit card needed for free trial)
#    Models: gpt-oss-120b (120B params, fastest inference on the planet)
CEREBRAS_API_KEY=

# 2. NVIDIA NIM: 40 req/min free — Llama 3.3 70B, DeepSeek, Mistral
#    Sign up: build.nvidia.com → free account → Generate API Key
#    Key starts with: nvapi-...
NVIDIA_API_KEY=

# 3. OpenRouter: 50 req/day free (:free models), or buy $10 for 1000/day
#    Sign up: https://openrouter.ai
OPENROUTER_API_KEY=

# 4. Together AI: pay-as-you-go fallback (Llama-3.3-70B)
#    Sign up: https://www.together.ai
TOGETHER_API_KEY=

# 5. Ollama: local LLM fallback (zero cost, needs local GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Real image sources for thumbnail backgrounds (replaces placeholder/solid colours) ---
# Priority: Pixabay → Unsplash → Pexels → Wikimedia Commons

# 1. Pixabay: FREE, no attribution needed, 100 req/min
#    Sign up free: pixabay.com/api/docs/
PIXABAY_API_KEY=

# 2. Unsplash: 50 req/hour free (attribution chip auto-rendered on thumbnail)
#    Sign up free: unsplash.com/developers → "New Application"
UNSPLASH_ACCESS_KEY=

# 3. Pexels: 200 req/hour, 20k/month free (new key issuance paused but old keys work)
#    Sign up: pexels.com/api/new/
PEXELS_API_KEY=

# Wikimedia Commons is used automatically with no key (CC/public domain)
UNSPLASH_WAIT=0
MAKE_IG_WEBHOOK_URL=

# --- Retention integrity and motion ---
# Optional Gemini native-language rewrite pass for Telugu/Hindi.
NATIVE_JUDGE=0
# Optional Groq Whisper transcription check of the final MP3.
ASR_GATE=0
# Optional extra whoosh/bed/loudness pass after the built-in audio mix.
AUDIO_ENHANCE=0
# Optional Gemini frame verification for stock footage.
VISION_VERIFY=0
VISION_MODEL=gemini-1.5-flash-latest
# Set to 0 to keep still photos as stills instead of creating Ken Burns clips.
MOTION_STILLS=1

# --- Sarvam AI (best Indian-language TTS + voice cloning) ---
# Free trial at https://dashboard.sarvam.ai — no credit card needed
# ₹20 per 10,000 chars (~1 month of daily Shorts under ₹50)
SARVAM_API_KEY=
# OPTIONAL: path to a 10-15s WAV recording of your own voice.
# The pipeline clones it once and uses it for every video.
# Record yourself speaking clearly in a quiet room, save as my_voice.wav,
# put it in the repo root or give the full path here.
SARVAM_VOICE_SAMPLE=
TG_BOT_TOKEN=
TG_CHAT_ID=
GH_TOKEN=
GH_REPO=yourname/shorts-host
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT=https://developers.facebook.com/tools/explorer/callback/
IG_API_VERSION=v23.0
IG_USER_TE=
IG_PASS_TE=
IG_USER_HI=
IG_PASS_HI=
IG_USER_ID_TE=
IG_TOKEN_TE=
IG_USER_ID_HI=
IG_TOKEN_HI=

# Optional voices and audio overrides
SARVAM_VOICE_TE=
SARVAM_VOICE_HI=
SARVAM_VOICE_LANGUAGE=te-IN
TTS_VOICE_TE=
TTS_VOICE_HI=
GEMINI_CONSENT_AUDIO=assets/voice_samples/consent.wav
GEMINI_MIN_INTERVAL=2.0
